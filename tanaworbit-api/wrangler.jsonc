{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanaworbit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "api.tanaw-orbit.app",
      "custom_domain": true
    }
  ]
}