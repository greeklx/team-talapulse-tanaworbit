{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanaworbit-console",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "tanaw-orbit.app",
      "custom_domain": true
    },
    {
      "pattern": "www.tanaw-orbit.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
